DB_PATH=qualifier.db
# Set to use PostgreSQL instead of the SQLite file, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=
# Comma-separated; keep two values during rotation
GUPSHUP_WEBHOOK_TOKENS=change-me
GUPSHUP_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
# Gupshup's published IP ranges (CIDR, comma-separated). Empty disables the check.
GUPSHUP_ALLOWED_IPS=
MAX_EVENT_AGE_SECONDS=86400
GUPSHUP_BASE_URL=https://partner.gupshup.io
GUPSHUP_APP_TOKEN=
L2R_BASE_URL=http://localhost:9000
L2R_API_KEY=
INTERNAL_API_KEY=
LOG_FILE=logs/qualifier.log
DEALER_PANEL_BASE_URL=
DEALER_PANEL_API_KEY=
